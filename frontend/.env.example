# CoastGuard-AI Frontend Environment Configuration
# Copy this file to .env or .env.local to connect to your live FastAPI backend

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Demo fixtures are disabled by default. Set true only for an explicit demo.
VITE_ENABLE_DEMO_FALLBACK=false

# Optional GIS Satellite Basemap Keys (defaults to open Esri World Imagery & Labels)
# VITE_MAPBOX_TOKEN=your_mapbox_token_here
# VITE_ESRI_API_KEY=your_esri_api_key_here
